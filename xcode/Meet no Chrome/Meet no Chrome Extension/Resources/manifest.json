{
  "manifest_version": 3,
  "name": "Google Meet no Chrome",
  "version": "1.4.0",
  "icons": { "128": "icon.png" },
  "description": "Abre links do Google Meet no Google Chrome.",
  "permissions": ["nativeMessaging"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [{
    "matches": ["<all_urls>"],
    "js": ["meet-links.js"],
    "run_at": "document_start"
  }],
  "browser_specific_settings": {
    "safari": { "strict_min_version": "15.4" }
  }
}
